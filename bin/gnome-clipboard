#!/usr/bin/env python3
"""Entry point: `gnome-clipboard [daemon|toggle]`."""
import os
import sys

# Resolve symlinks (install.sh links this file into ~/.local/bin).
ROOT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
sys.path.insert(0, ROOT)

from gnome_clipboard import app  # noqa: E402

if __name__ == "__main__":
    sys.exit(app.main(sys.argv))
